[Unit]
Description=Whisper Flow RS - ditado por voz (Groq)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/whisper-flow-rs
# Configuração em ~/.config/whisper-flow-rs/.env (lido pelo próprio programa)
Restart=on-failure
RestartSec=2
Nice=5
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
